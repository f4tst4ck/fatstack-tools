# @fatstack/x402 reads no environment directly — a host application passes configuration
# in. These are the values a provider integrating the SDK will need.

# base | base-sepolia. Test against base-sepolia first; the money is real on base.
X402_NETWORK=base-sepolia

# The facilitator that verifies payment authorisations and settles them on chain.
# https://x402.org/facilitator is the public one and needs no key. Point this at any
# facilitator you trust — it is a URL, not a code path.
FACILITATOR_URL=https://x402.org/facilitator
# Only if your facilitator requires one. The public facilitator does not.
FACILITATOR_API_KEY=

# direct  = the agent pays the provider's wallet, wallet to wallet.
# splitter = payment goes through a splitter contract that pays the provider and a
#            platform fee in one transaction. See contracts/.
FEE_MODE=direct
# Required when FEE_MODE=splitter. The SDK refuses to fall back to direct if this is
# missing, because silently paying the wrong address is worse than failing.
SPLITTER_ADDRESS=

# 1 takes every paywalled route offline with a 503 and takes no payment.
KILLSWITCH=0
